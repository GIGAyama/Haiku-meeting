  "_CDN": "実行コードを外から取ってはいけない。学校のフィルタリングで塞がれると画面が出ない。",
  "禁止するCDN": [
    "cdn.tailwindcss.com",
    "unpkg.com",
    "cdn.jsdelivr.net",
    "cdnjs.cloudflare.com",
    "babel/standalone"
  ],

  "_見た目だけの外部参照": "止まっても字の形が変わるだけなので許す（§2-7）。",
  "許す外部参照": ["fonts.googleapis.com", "fonts.gstatic.com"]
}
